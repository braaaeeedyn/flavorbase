# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/flavorbase
DATABASE_USERNAME=flavorbase
DATABASE_PASSWORD=your_secure_password

# JWT Configuration
JWT_SECRET=your-very-secure-secret-key-that-should-be-at-least-256-bits-long-for-production

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=10MB

# Email Configuration (for future use)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
